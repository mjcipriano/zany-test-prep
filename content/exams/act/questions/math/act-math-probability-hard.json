    "subskill": "simple_probability",
    "prompt": "In a survey, 12% of respondents own a bicycle, 40% own a scooter, and 8% own both. If a respondent is selected at random, what is the probability that the respondent owns a bicycle or a scooter (or both)?",
    "choices": [
      {
        "id": "A",
        "text": "2/25",
        "rationale": "That is P(both), not P(either)."
      },
      {
        "id": "B",
        "text": "13/25",
        "rationale": "Subtract the overlap; it was counted twice."
      },
      {
        "id": "C",
        "text": "3/5",
        "rationale": "The overlap is subtracted, not added."
      },
      {
        "id": "D",
        "text": "6/125",
        "rationale": "Multiplying is for independent 'and', not for 'or'."
      },
      {
        "id": "E",
        "text": "11/25",
        "rationale": "Correct."
      }
    ],
    "correct_choice": "E",
    "explanation": "P(A or B) = P(A) + P(B) − P(A and B) = (12 + 40 − 8)/100 = 11/25.",
    "estimated_time_seconds": 90,
    "tags": [
      "probability",
      "family:pb_single"
    ],
    "answer_verification": "P=11/25"
  },
