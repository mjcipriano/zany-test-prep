    "question_type": "multiple_choice",
    "subskill": "simple_probability",
    "prompt": "In a survey, 20% of respondents own a bicycle, 10% own a scooter, and 5% own both. If a respondent is selected at random, what is the probability that the respondent owns a bicycle or a scooter (or both)?",
    "choices": [
      {
        "id": "A",
        "text": "1/20",
        "rationale": "That is P(both), not P(either)."
      },
      {
        "id": "B",
        "text": "1/4",
        "rationale": "Correct."
      },
      {
        "id": "C",
        "text": "3/10",
        "rationale": "Subtract the overlap; it was counted twice."
      },
      {
        "id": "D",
        "text": "7/20",
        "rationale": "The overlap is subtracted, not added."
      },
      {
        "id": "E",
        "text": "1/50",
        "rationale": "Multiplying is for independent 'and', not for 'or'."
      }
    ],
    "correct_choice": "B",
    "explanation": "P(A or B) = P(A) + P(B) − P(A and B) = (20 + 10 − 5)/100 = 1/4.",
    "estimated_time_seconds": 90,
    "tags": [
      "probability",
      "family:pb_single"
    ],
    "answer_verification": "P=1/4"
  },
