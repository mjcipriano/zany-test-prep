    "subskill": "simple_probability",
    "prompt": "In a survey, 50% of respondents own a bicycle, 20% own a scooter, and 12% own both. If a respondent is selected at random, what is the probability that the respondent owns a bicycle or a scooter (or both)?",
    "choices": [
      {
        "id": "A",
        "text": "3/25",
        "rationale": "That is P(both), not P(either)."
      },
      {
        "id": "B",
        "text": "41/50",
        "rationale": "The overlap is subtracted, not added."
      },
      {
        "id": "C",
        "text": "7/10",
        "rationale": "Subtract the overlap; it was counted twice."
      },
      {
        "id": "D",
        "text": "29/50",
        "rationale": "Correct."
      },
      {
        "id": "E",
        "text": "1/10",
        "rationale": "Multiplying is for independent 'and', not for 'or'."
      }
    ],
    "correct_choice": "D",
    "explanation": "P(A or B) = P(A) + P(B) − P(A and B) = (50 + 20 − 12)/100 = 29/50.",
    "estimated_time_seconds": 90,
    "tags": [
      "probability",
      "family:pb_single"
    ],
    "answer_verification": "P=29/50"
  },
