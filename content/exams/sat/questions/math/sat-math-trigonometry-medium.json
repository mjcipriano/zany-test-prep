      },
      {
        "id": "C",
        "text": "9",
        "rationale": "Scale by the actual hypotenuse."
      },
      {
        "id": "D",
        "text": "18",
        "rationale": "Correct."
      }
    ],
    "correct_choice": "D",
    "explanation": "sin θ = opposite/hypotenuse → opposite = (9/15)·30 = 18.",
