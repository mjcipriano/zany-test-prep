        "id": "A",
        "text": "16/30",
        "rationale": "tan θ = sin θ/cos θ = opposite/adjacent, not the reciprocal."
      },
      {
        "id": "B",
        "text": "34/16",
        "rationale": "That is sec θ, the reciprocal of cos θ."
      },
      {
        "id": "C",
        "text": "15/8",
        "rationale": "Correct."
      },
      {
        "id": "D",
        "text": "30/34",
        "rationale": "That is sin θ."
      }
    ],
    "correct_choice": "C",
    "explanation": "sin θ = √(1 − (16/34)²) = 30/34; tan θ = sin θ/cos θ = (30/34)/(16/34) = 30/16 = 15/8.",
