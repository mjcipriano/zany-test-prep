    "prompt": "In a right triangle, tan θ = 35/12. What is the value of cos θ?",
    "choices": [
      {
        "id": "A",
        "text": "37/12",
        "rationale": "This inverts cos θ."
      },
      {
        "id": "B",
        "text": "35/12",
        "rationale": "That is tan θ again."
      },
      {
        "id": "C",
        "text": "12/37",
        "rationale": "Correct."
      },
      {
        "id": "D",
        "text": "35/37",
        "rationale": "That is sin θ."
      }
    ],
    "correct_choice": "C",
    "explanation": "From tan θ = 35/12 the sides are opposite 35, adjacent 12, hypotenuse 37 (since 35² + 12² = 37²). So cos θ = 12/37.",
    "estimated_time_seconds": 95,
